<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MyFront</RootNamespace>
    <AssemblyName>MyFront</AssemblyName>
    <Version>0.1.0</Version>
    <Product>MyFront</Product>
    <Description>Lightweight MariaDB / MySQL client</Description>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <Deterministic>true</Deterministic>
    <!-- no designer files: WinForms designer-serialization analyzers don't apply -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="MiniExcel" Version="1.46.0" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <!-- The native Scintilla/Lexilla DLLs are embedded below and extracted at runtime (see ScintillaLoader),
         so the package's loose "runtimes\" content is not copied next to the exe. -->
    <PackageReference Include="Scintilla5.NET" Version="6.1.2" ExcludeAssets="build;native" GeneratePathProperty="true" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- SSH.NET's crypto library is only used while a tunnel opens: plain IL (4.9 MB) instead of ReadyToRun (11.7 MB) -->
    <PublishReadyToRunExclude Include="BouncyCastle.Cryptography.dll" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PkgScintilla5_NET)\runtimes\win-x64\native\Scintilla.dll" LogicalName="MyFront.native.Scintilla.dll" />
    <EmbeddedResource Include="$(PkgScintilla5_NET)\runtimes\win-x64\native\Lexilla.dll" LogicalName="MyFront.native.Lexilla.dll" />
    <!-- yellow "M"; regenerate with tools\make-icon.ps1 -->
    <EmbeddedResource Include="app.ico" LogicalName="MyFront.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- licenses of everything shipped in the exe, next to it (not bundled); keep in step with the packages above -->
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MyFront.SelfTest" />
  </ItemGroup>

</Project>
